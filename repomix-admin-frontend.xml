            <XMarkIcon className="w-6 h-6" />
          </button>

          <div className="flex-1 overflow-y-auto pt-4 px-3 pb-3">
            <Navigation onItemClick={closeSidebar} />
          </div>

          <div className="p-4 border-t border-gray-800">
